{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JonathanRReed/apple-files-mcp",
  "title": "Apple Files",
  "description": "Inspect and manage local files and folders inside allowed roots on macOS.",
  "repository": {
    "url": "https://github.com/JonathanRReed/Apple-MCPs",
    "source": "github",
    "id": "1194217206",
    "subfolder": "AppleFiles-MCP"
  },
  "version": "1.0.2",
  "websiteUrl": "https://github.com/JonathanRReed/Apple-MCPs",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "apple-files-mcp",
      "version": "1.0.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APPLE_FILES_MCP_SAFETY_MODE",
          "description": "Safety mode for file operations: safe_readonly, safe_manage, or full_access.",
          "isRequired": false,
          "format": "string",
          "choices": [
            "safe_readonly",
            "safe_manage",
            "full_access"
          ],
          "default": "safe_manage"
        },
        {
          "name": "APPLE_FILES_MCP_ALLOWED_ROOTS",
          "description": "Comma-separated directories the server may access. Defaults to Desktop, Documents, Downloads, and iCloud Drive.",
          "isRequired": false,
          "format": "string",
          "placeholder": "~/Desktop,~/Documents,~/Downloads"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/JonathanRReed/Apple-MCPs/releases/download/v1.0.1/apple-files-1.0.1.mcpb",
      "version": "1.0.2",
      "fileSha256": "23a1dd1a43f44814fab152a3a24458c1ebe9007c49e0971c0d03fe4eda983891",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
