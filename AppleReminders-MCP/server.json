{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JonathanRReed/apple-mcp-reminders",
  "title": "Apple Reminders",
  "description": "List, create, update, complete, and delete reminders in Apple Reminders on macOS.",
  "repository": {
    "url": "https://github.com/JonathanRReed/Apple-MCPs",
    "source": "github",
    "id": "1194217206",
    "subfolder": "AppleReminders-MCP"
  },
  "version": "1.0.3",
  "websiteUrl": "https://github.com/JonathanRReed/Apple-MCPs",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "apple-mcp-reminders",
      "version": "1.0.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APPLE_REMINDERS_MCP_SAFETY_MODE",
          "description": "Safety mode for Reminders operations: safe_readonly, safe_manage, or full_access.",
          "isRequired": false,
          "format": "string",
          "choices": [
            "safe_readonly",
            "safe_manage",
            "full_access"
          ],
          "default": "safe_manage"
        },
        {
          "name": "APPLE_REMINDERS_MCP_ALLOWED_LISTS",
          "description": "Comma-separated allow-list of reminder list names. Empty allows all lists.",
          "isRequired": false,
          "format": "string",
          "placeholder": "Reminders,Groceries"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/JonathanRReed/Apple-MCPs/releases/download/v1.0.2/apple-reminders-1.0.2.mcpb",
      "version": "1.0.3",
      "fileSha256": "b5d0169018d03c371b78f0025d9a64835b325b637d2e344d502d6ce3e9c2794a",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
