{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "apple-files",
  "display_name": "Apple Files",
  "version": "1.0.4",
  "description": "Inspect and manage local files and folders inside allowed roots on macOS.",
  "long_description": "Local MCP server for scoped file, Finder-adjacent, and iCloud Drive workflows on macOS. Use it to inspect directories, search files, read text files, prepare attachments, reveal paths in Finder, manage Finder tags, and perform bounded file mutations inside explicit allowed roots.",
  "icon": "icon.png",
  "author": {
    "name": "Jonathan Reed"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/Apple-MCPs"
  },
  "license": "MIT",
  "keywords": [
    "files",
    "finder",
    "attachments",
    "macos",
    "documents",
    "folders"
  ],
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "python": ">=3.11"
    }
  },
  "server": {
    "type": "uv",
    "entry_point": "server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "server.py"
      ],
      "env": {
        "APPLE_FILES_MCP_ALLOWED_ROOTS": "${HOME}/Desktop,${HOME}/Documents,${HOME}/Downloads,${HOME}/Library/Mobile Documents/com~apple~CloudDocs",
        "APPLE_FILES_MCP_SAFETY_MODE": "safe_manage"
      }
    }
  },
  "tools": [
    {
      "name": "search_tools",
      "description": "Search available tools by keyword."
    },
    {
      "name": "get_tool_info",
      "description": "Read the schema and usage of an available tool."
    }
  ],
  "tools_generated": true,
  "prompts_generated": true
}
