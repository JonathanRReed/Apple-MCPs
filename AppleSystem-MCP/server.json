{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jonathanrreed/apple-system-mcp",
  "title": "Apple System",
  "description": "Read and manage macOS system settings and perform scoped desktop actions.",
  "repository": {
    "url": "https://github.com/JonathanRReed/Apple-MCPs",
    "source": "github",
    "id": "1194217206",
    "subfolder": "AppleSystem-MCP"
  },
  "version": "1.0.1",
  "websiteUrl": "https://github.com/JonathanRReed/Apple-MCPs",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "apple-system-mcp",
      "version": "1.0.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APPLE_SYSTEM_MCP_SAFETY_MODE",
          "description": "Safety mode for system operations: safe_readonly, safe_manage, or full_access.",
          "isRequired": false,
          "format": "string",
          "choices": [
            "safe_readonly",
            "safe_manage",
            "full_access"
          ],
          "default": "safe_manage"
        }
      ]
    }
  ]
}
